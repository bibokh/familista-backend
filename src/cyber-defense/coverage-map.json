      ]
    },
    "5": {
      "name": "Club / tenant isolation",
      "flow": "club A → club B",
      "trustBoundary": "tenant → tenant",
      "owner": "club",
      "dataClass": "club",
      "boundaryType": "tenant",
      "coverage": "P",
      "controls": [
        "tenant-guard",
        "db-rls-pilot",
        "db-rls-system-paths-reviewed",
        "franchise-club-attach-authorised"
      ],
      "reason": "Every route id is guarded or exempted by name (R2), and PostgreSQL enforces row-level security on 18 club tables (R14 Stage 4: the pilot's four and 14 club-private health, safeguarding, contract, attendance, finance, calendar and staff-note tables), fail closed and proven on real PostgreSQL — but ids in request bodies are not inventoried, and every other club table relies on the application.",
      "plannedIn": "Owner decision after Batch 7: extend the protected tables table by table; inventory ids in request bodies"
    },
