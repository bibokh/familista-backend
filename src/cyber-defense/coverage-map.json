{
  "$comment": "Cyber Defense R5 — every component of the platform, declared against the trust-boundary rows that govern it. Components are discovered from the code by scripts/security-discover.js; a component the code has and this map does not, or this map has and the code does not, fails the posture test. A row marked C must have every control it names PRESENT (or a pinning test); P and U must say why and which batch closes them. The ratchet only moves down.",
  "schemaVersion": 1,
  "coverageKey": {
    "C": "Covered by Cyber Defense controls pinned by tests",
    "P": "Partially covered",
    "U": "Uncovered"
  },
  "ratchet": {
    "U": 0,
    "P": 6
  },
  "boundaries": {
    "1": {
      "name": "Browser → API (SPA, admin app)",
      "flow": "browser → api",
      "trustBoundary": "internet → app",
      "owner": "platform",
      "dataClass": "personal",
      "boundaryType": "network",
      "coverage": "P",
      "controls": [
        "csp-script-self",
        "csp-no-plugins-no-frames",
        "cors-allowlist",
        "cors-rejection-is-403"
      ],
      "reason": "The React client keeps nothing in browser storage (R7: access token in memory, refresh token in the httpOnly cookie), but the familista-v5 static site (frontend/) still writes the access token to localStorage.",
      "plannedIn": "Follow-up outside the approved plan — awaiting scheduling"
    },
    "2": {
      "name": "Sign-in, register, refresh, reset",
      "flow": "client → identity",
      "trustBoundary": "anonymous → identity",
      "owner": "platform",
      "dataClass": "credentials",
      "boundaryType": "identity",
      "coverage": "P",
      "controls": [
        "auth-rate-limit",
        "password-hashing-bcrypt",
        "refresh-token-hashed-at-rest",
        "mfa-service",
        "mfa-owner-enforcement-at-login",
        "login-lockout-shadow",
        "login-lockout",
        "mfa-required-for-admins",
        "self-registration-closed"
      ],
      "reason": "Lockout is enforced, self-registration into a club is closed (accounts come only from invitations), and administrators can be required to use MFA (R7, behind MFA_REQUIRED_FOR_ADMINS) — but MFA keys off the account role rather than effective authority and is not required of every privileged account, and the legacy refresh-token fallback remains until pre-Step-8 tokens expire.",
      "plannedIn": "Follow-up outside the approved plan — awaiting scheduling"
    },
    "3": {
      "name": "JWT verification",
      "flow": "token → identity",
      "trustBoundary": "token → identity",
      "owner": "platform",
      "dataClass": "credentials",
      "boundaryType": "identity",
      "coverage": "C",
      "controls": [
        "session-revocation-token-version",
        "jwt-algorithm-pinned",
        "jwt-issuer-validated",
        "jwt-key-id"
      ]
    },
    "4": {
      "name": "API authentication coverage",
      "flow": "anonymous → api",
      "trustBoundary": "anonymous → authenticated",
      "owner": "platform",
      "dataClass": "all",
      "boundaryType": "identity",
      "coverage": "C",
      "controls": [],
      "pinnedBy": [
