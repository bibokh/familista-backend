# ============================================================
# FAMILISTA BACKEND — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Server
NODE_ENV=development
PORT=4000
API_VERSION=v1

# Database (PostgreSQL via Supabase / Neon / Railway)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/familista?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-also-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Anthropic (Claude AI)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ACADEMY=price_...

# CORS
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ============================================================
# Email delivery — the Familista email gateway
# ============================================================
# Nothing in Familista talks to a provider directly. Product code calls
# EmailService; EmailService picks an adapter from these values. Replacing a
# provider is a change here and in one adapter, never in the invitation,
# password-reset or notification code.
#
# With NOTHING set below, Familista still runs: invitations are created,
# tokens are minted and everything stays valid. Delivery simply reports
# "EMAIL DELIVERY NOT CONFIGURED", and no screen claims an email was sent.

# Which adapter to use. Leave empty to pick the first one configured below.
#   sendgrid | smtp | none
EMAIL_PROVIDER=

# The address invitations come from. Must be a sender your provider has
# verified, or the provider will refuse with a CONFIGURATION failure.
EMAIL_FROM=noreply@familista.app
EMAIL_FROM_NAME=Familista

# The public origin an acceptance link points at. No trailing slash.
# Acceptance links are built as PUBLIC_APP_URL + /invite/accept?token=...
PUBLIC_APP_URL=https://app.familista.example

# ── SendGrid ──
SENDGRID_API_KEY=

# ── SMTP (requires the optional `nodemailer` package to be installed) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# How long one send attempt may take, and how many attempts in total.
# Bounded on purpose: a provider that hangs must not hold up a club.
EMAIL_TIMEOUT_MS=8000
EMAIL_MAX_ATTEMPTS=2

# ============================================================
# Product analytics retention
# ============================================================
# Raw events expire; daily rollups are kept for history. Never "forever".
ANALYTICS_RAW_RETENTION_DAYS=90
ANALYTICS_ROLLUP_RETENTION_DAYS=1095

# Logging
LOG_LEVEL=debug
