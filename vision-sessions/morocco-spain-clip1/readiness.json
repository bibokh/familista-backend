      },
      {
        "modality": "PLAYER_POD",
        "implemented": false,
        "contributes": [
          "per-player metric position independent of the camera",
          "position while the player is off-screen or occluded",
          "identity that cannot be swapped by a tracker"
        ],
        "rationale": "Vision loses a player behind another player and can swap two identities that cross \u2014 measured at four genuine switches on ten seconds of validation footage. A pod does neither, so fusing one removes the failure mode rather than reducing it."
      },
      {
        "modality": "FIELD_NODE",
        "implemented": false,
        "contributes": [
          "metric position with no pitch calibration at all",
          "a common time base every other instrument can sync to",
          "coverage during replays and close-ups"
        ],
        "rationale": "Phase 4 measured the structural problem: calibratable pitch geometry and visible football events are anti-correlated in broadcast footage, so only 21.6 % of frames carry a metric ball position. Field nodes supply position without needing the pitch to be visible, which removes the correlation instead of working around it."
      },
      {
        "modality": "BALL_SENSOR",
        "implemented": false,
        "contributes": [
          "the moment of contact, directly measured",
          "ball height, which no single camera can recover",
          "impact force and spin"
        ],
        "rationale": "A touch is currently inferred from a change in the ball's motion seen from one viewpoint, and a ball in flight has no recoverable height, so a header and a ground touch are indistinguishable. A sensor in the ball measures the contact itself."
      }
    ],
