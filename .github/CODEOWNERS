# Cyber Defense, Step 9 — who reviews what.
#
# GitHub requests a review from the owner below on every pull request that
# touches a matching path. The security-critical paths are listed explicitly
# so that, when a second maintainer joins, ownership can be split without
# guessing which files matter. The last matching line wins.

*                                   @bibokh

# Authentication, sessions, MFA and the secrets they depend on
/src/auth-prod/                     @bibokh
/src/services/auth.service.ts       @bibokh
/src/services/password-reset.service.ts @bibokh
/src/middleware/                    @bibokh
/src/security/                      @bibokh
/src/fabric/secrets/                @bibokh
/src/config/                        @bibokh

# Cyber Defense: posture, policy and event schema
/src/cyber-defense/                 @bibokh
/scripts/security-discover.js       @bibokh

# Algorithms: the registry is the human-approval record for every algorithm in
# production, so an edit to it — a new version, a new approved fingerprint —
# is itself a reviewed change.
/src/algorithms/                    @bibokh
/scripts/algorithms-discover.js     @bibokh
# The build seal that ties the running code back to that approval.
/scripts/algorithms-seal.js         @bibokh
# The algorithm lab: candidates, the engine that judges them, and the process
# runner that keeps them out of the judging process — outside the build.
/lab/                               @bibokh

# Schema and migrations (run in production by render-start.sh)
/prisma/                            @bibokh

# Supply chain and delivery
/.github/                           @bibokh
/.gitleaksignore                    @bibokh
/package.json                       @bibokh
/package-lock.json                  @bibokh
/render.yaml                        @bibokh
/scripts/render-start.sh            @bibokh

# Backups and the restore drill: the drill handles the offline restore key
/scripts/restore-drill-ci.js        @bibokh
/scripts/restore-drill/             @bibokh
/scripts/restore-drill.ps1          @bibokh
