# Cyber Defense, Step 9 — who reviews what.
#
# GitHub requests a review from the owner below on every pull request that
# touches a matching path. The security-critical paths are listed explicitly
# so that, when a second maintainer joins, ownership can be split without
# guessing which files matter. The last matching line wins.
#
# The automation account (docs/security/github-governance.md) is never a code
# owner: its pull requests wait for the Platform Owner's review, and GitHub never
# counts an author's approval of their own pull request.

*                                   @bibokh

# Authentication, sessions, MFA and the secrets they depend on
/src/auth-prod/                     @bibokh
/src/services/auth.service.ts       @bibokh
/src/services/password-reset.service.ts @bibokh
/src/middleware/                    @bibokh
/src/security/                      @bibokh
/src/fabric/secrets/                @bibokh
/src/config/                        @bibokh

# Cyber Defense: posture, policy and event schema
/src/cyber-defense/                 @bibokh
/scripts/security-discover.js       @bibokh

# Algorithms: the registry is the human-approval record for every algorithm in
# production, so an edit to it — a new version, a new approved fingerprint —
# is itself a reviewed change.
/src/algorithms/                    @bibokh
/scripts/algorithms-discover.js     @bibokh
# The build seal that ties the running code back to that approval.
/scripts/algorithms-seal.js         @bibokh
# The algorithm lab: candidates, the engine that judges them, and the process
# runner that keeps them out of the judging process — outside the build.
/lab/                               @bibokh

# Approved LAB execution evidence (AI-0.5): the approval record and its dossiers.
# An entry takes effect only when the Platform Owner merges the reviewed pull
# request that carries it; the verifier that decides what production shows.
/src/platform/agents/published/     @bibokh
/src/platform/agents/execution-evidence.ts @bibokh

# Agent governance: the Agent Registry and its manifests, the tool registry,
# the autonomy ceilings and the global kill switch, the environment that tells
# the Lab from production, and the owner-only routes the Operations Room reads.
/src/platform/agents/               @bibokh
/src/platform/intelligence/         @bibokh
/src/platform/environment.ts        @bibokh
/src/routes/agents-room.routes.ts   @bibokh
/src/contracts/                     @bibokh

# Security documentation and the repository's own rules for its maintainers.
/docs/security/                     @bibokh
/SECURITY.md                        @bibokh
/CLAUDE.md                          @bibokh
/docs/BACKUP_AND_RESTORE.md         @bibokh

# The gates CI runs: the audit gate and the browser proof.
/scripts/npm-audit-gate.js          @bibokh
/tools/components/                  @bibokh

# Production deployment: the deploy and backup triggers, and the migration step
# render-start.sh runs.
/scripts/backup-trigger.js          @bibokh
/scripts/db-migrate.js              @bibokh

# Published LAB evidence, and what decides whether it is shown: the dossiers,
# their provenance and the approval record; the server's verifiers; the
# definitions they were replayed from. Advisory until the ruleset on main
# requires review from Code Owners, and only an approval by someone other than
# the pull request's author counts
# (docs/security/evidence-publication-enforcement.md).
/src/platform/agents/published/     @bibokh
/src/platform/agents/execution-evidence.ts   @bibokh
/src/platform/agents/execution-provenance.ts @bibokh
/lab/orchestrator/definitions/      @bibokh

# Schema and migrations (run in production by render-start.sh)
/prisma/                            @bibokh

# Supply chain and delivery
/.github/                           @bibokh
/.gitleaksignore                    @bibokh
/package.json                       @bibokh
/package-lock.json                  @bibokh
/render.yaml                        @bibokh
/scripts/render-start.sh            @bibokh

# Backups and the restore drill: the drill handles the offline restore key
/scripts/restore-drill-ci.js        @bibokh
/scripts/restore-drill/             @bibokh
/scripts/restore-drill.ps1          @bibokh
